# Adapter binaries (Google platform-tools) — not ours, huge
platform-tools/
tools/platform-tools/
# Decompiled FAP app source — third-party, excluded by request
fap_src/
# Full Android bugreports contain broad phone/device data — keep only extracted OBD logs
tools/btsnoop/data/*.zip
# iPhone sysdiagnose archives, same concern: broad device data, kept local
sysdiagnose_*
*.pklg
# ThinkDiag captures carry the adapter's serial and its licence/activation
# payload, and this repository is public — keep them local. Covers both the
# app's own frame logs and the raw HCI snoops, which record the same exchange.
tools/btsnoop/data/*thinkdiag*
tools/btsnoop/data/*9TFD*
tools/btsnoop/data/*BT_HCI*
tools/btsnoop/data/*btsnoop_postreboot*
__pycache__/
*.pyc

# Android build outputs
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/.idea/

# iOS build outputs. The .xcodeproj is generated by XcodeGen on the CI runner,
# so it is not checked in either.
ios/build/
ios/Valeo.xcodeproj/
ios/Info.plist
Payload/
*.ipa
source.json
ios/build-test/
ios/test.log

# The ThinkDiag licence and activation replay, produced by
# tools/thinkdiag/make_script.py. Carries the adapter licence blob and its
# activation credentials: local only, never committed.
tools/thinkdiag/data/
